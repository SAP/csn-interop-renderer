{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist/csn-renderer",
    "exactOptionalPropertyTypes": false,
    "noEmit": true
  },
  "include": ["src/components/csn-renderer/**/*"],
  "exclude": ["node_modules", "dist", "**/__tests__/**"]
}
