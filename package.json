{
  "$schema": "http://json.schemastore.org/package",
  "name": "@sap/csn-interop-renderer",
  "version": "0.5.0",
  "description": "Converts documents defined using CSN Interoperability Specification into markdown/HTML human readable documentation pages.",
  "keywords": [],
  "author": "SAP SE",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAP/csn-interop-renderer.git"
  },
  "homepage": "https://sap.github.io/csn-interop-renderer/",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react/styles": {
      "types": "./dist/react/styles.d.ts",
      "default": "./dist/react/csn-interop-renderer.css"
    },
    "./package.json": "./package.json"
  },
  "bin": "./cli/cli.js",
  "files": [
    "dist/",
    "cli/"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "cli": "npm run build && node --experimental-vm-modules --no-warnings=ExperimentalWarning ./cli/cli.js -i ./examples/Airline.json -o ./examples/out.md -r md",
    "prebuild": "rimraf ./dist",
    "build": "npm run build:core && npm run build:react",
    "build:core": "tsc -p tsconfig.build.json",
    "build:react": "vite build --config vite.config.react.ts && tsc -p tsconfig.react.build.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --ci --collectCoverage",
    "test:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --watchAll",
    "lint:staged": "lint-staged",
    "eslint": "eslint . --fix",
    "eslint:ci": "eslint .",
    "prettier": "prettier --write \"**/*.{json,yml,yaml,md}\"",
    "prettier:ci": "prettier --check \"**/*.{json,yml,yaml,md}\"",
    "prepare": "is-ci || husky"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@open-resource-discovery/ui-components": "0.2.0",
    "@sap/csn-interop-specification": "1.2.4",
    "classnames": "2.5.1",
    "commander": "15.0.0",
    "json-schema-library": "11.6.1",
    "dompurify": "3.4.15",
    "marked": "18.0.6",
    "marked-gfm-heading-id": "4.1.4",
    "monaco-editor": "0.56.0",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@expo/spawn-async": "1.8.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@sap/eslint-config": "0.5.2",
    "@tsconfig/node22": "22.0.5",
    "@types/jest": "30.0.0",
    "@types/tmp": "0.2.6",
    "eslint": "10.7.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "jest": "30.4.2",
    "jest-cli": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-junit": "17.0.0",
    "jest-watch-typeahead": "3.0.1",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "rimraf": "6.1.3",
    "tmp": "0.2.7",
    "ts-jest": "29.4.11",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  },
  "lint-staged": {
    "./**/*.{js,ts}": [
      "eslint --fix"
    ],
    "**/*.{md,json,yaml,yml}": [
      "prettier --write"
    ]
  }
}
